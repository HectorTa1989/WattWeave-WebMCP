    {
      "id": "01-intro",
      "narration": "This is WattWeave. A peak demand alert arrives, and an agent turns it into a safe, reversible load plan, with a human in the loop. It all runs in a deterministic sandbox: no real device ever gets a command.",
      "shots": [
        {
          "image": "frames/00-01-intro.png",
          "target": null,
          "click": false,
          "highlights": [
            {
              "x": 1042,
              "y": 41,
              "width": 212,
              "height": 40,
              "label": "Sandbox · no devices"
            },
            {
              "x": 881,
              "y": 41,
              "width": 142,
              "height": 40,
              "label": "Live WebMCP tools"
            }
          ],
          "weight": 2.2
        }
      ]
    },
    {
