# --- Polar.sh billing (optional — the app runs fully in offline demo mode without these) ---

# Hosted checkout link for the "WattWeave Pro" product, created in the Polar dashboard
# (Products → WattWeave Pro → Checkout Links). Opened when a Free user clicks "Upgrade".
VITE_POLAR_CHECKOUT_LINK=https://buy.polar.sh/polar_cl_REPLACE_ME

# Your Polar organization slug (used for "Manage subscription" links).
VITE_POLAR_ORG=hectorta1989

# Optional: a server endpoint that proxies Polar license-key validation
# (see README "Wiring real Polar license validation"). When unset, WattWeave
# validates license keys offline in demo mode (WATT-XXXX-XXXX pattern).
VITE_POLAR_VALIDATE_URL=
